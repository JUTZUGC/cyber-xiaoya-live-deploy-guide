    "deploy": {
      "type": "script",
      "requires": [
        "python"
      ],
      "steps": [
        "git clone https://github.com/cyber-xiaoya/cyber-xiaoya-live.git",
        "cd cyber-xiaoya-live",
        "pip install uv",
        "uv venv .venv --python 3.12",
        "uv pip install -r requirements.txt",
        "cp config.example.json config.json",
        ".venv/bin/python -m src.main"
      ],
      "stepsPs": [
        "git clone https://github.com/cyber-xiaoya/cyber-xiaoya-live.git",
        "Set-Location cyber-xiaoya-live",
        "pip install uv",
        "uv venv .venv --python 3.12",
        "uv pip install -r requirements.txt --default-index https://pypi.tuna.tsinghua.edu.cn/simple",
        "copy config.example.json config.json",
        ".venv\\Scripts\\python.exe -m src.main"
      ],
      "source": "https://github.com/cyber-xiaoya/cyber-xiaoya-live#readme"
    },
    "pitfalls": [
      "装依赖失败：用 Python 3.12 与国内 PyPI 镜像",
      "TTS 起不来：按 `tools/omnivoice/README.md` 在 WSL2 里单独部署",
      "舞台页空白：确认桥已监听 8795，浏览器访问 `/stage`",
      "连线失败：检查 Vidu Key 与账户余额",
      "显存不足：关闭其他占卡程序，或降低分辨率",
      "费用超预期：测完马上断开，别挂着",
      "配置泄露：`config.json` 不要提交到仓库"
    ]
  },
